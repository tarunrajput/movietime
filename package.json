{
  "name": "movietime",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "yarn@4.16.0",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start",
    "lint": "eslint .",
    "test": "jest",
    "format:check": "prettier --check \"src/**/*.{js,ts,tsx}\" \"app/**/*.{js,ts,tsx}\" \"*.{js,ts,tsx}\" \"*.json\"",
    "format:write": "prettier --write \"src/**/*.{js,ts,tsx}\" \"app/**/*.{js,ts,tsx}\" \"*.{js,ts,tsx}\" \"*.json\"",
    "typecheck": "tsc --noEmit",
    "doctor": "npx react-doctor@latest"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.(ts|tsx|js)"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.102.2",
    "expo": "^54.0.37",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-nitro-fetch": "^1.6.2",
    "react-native-nitro-modules": "^0.37.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-reanimated-carousel": "^5.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@react-native/eslint-config": "0.81.6",
    "@react-native/metro-config": "0.81.6",
    "@types/jest": "^29",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-babel-module": "^5.3.2",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.12",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2"
  }
}
